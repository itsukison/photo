# Supabase (shared with the Membercheck internal app)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only privileged key used by trusted webhook notification work.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Resend (server-only)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="bookings@your-verified-domain.com"
RESEND_FROM_NAME="@ Studio ON"
# Optional; customer replies fall back to RESEND_FROM_EMAIL.
RESEND_REPLY_TO_EMAIL="studio.on.snap@gmail.com"
